# ==========================================
# Digital Warranty & Purchase Manager
# Environment Configuration Template
# ==========================================

# ------------------------------------------
# Local Development (.env)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_BACKEND_URL=http://localhost:5000
VITE_PORT=5173

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=super-secret-key-for-development
DATABASE_PATH=database/warranty_manager.db
UPLOAD_FOLDER=uploads
BACKEND_PORT=5000
BACKEND_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------
# Production Settings Template
# (Set these in Vercel & Render Dashboards)
# ------------------------------------------
# Vercel Project Environment Variables:
# VITE_API_BASE_URL=https://<YOUR-RENDER-APP-NAME>.onrender.com/api
# VITE_BACKEND_URL=https://<YOUR-RENDER-APP-NAME>.onrender.com

# Render Web Service Environment Variables:
# FLASK_ENV=production
# SECRET_KEY=generate-a-strong-random-secret-key
# CORS_ORIGIN=https://<YOUR-VERCEL-APP-NAME>.vercel.app
# DATABASE_PATH=database/warranty_manager.db
# UPLOAD_FOLDER=uploads
